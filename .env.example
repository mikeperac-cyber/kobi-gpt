MONGO_URI=mongodb://localhost:27017
MONGO_DB=kobigpt
# Leave empty for local dev (uses a built-in dev default). For any non-localhost FRONTEND_ORIGIN set a long
# random value (32+ chars), e.g. PowerShell: [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
JWT_SECRET=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=45
DEMO_LLM_TIMEOUT_SECONDS=25
FRONTEND_ORIGIN=http://localhost:5173
EMAIL_PROVIDER=
# Password of the seeded demo accounts. Required for `python -m app.seed` against a real MongoDB;
# in MONGO_URI=mongomock:// mode, empty means the password is demo12345.
SEED_PASSWORD=
ADMIN_EMAIL=
